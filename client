local orderCounter = 0
local knownIds = {}

local function addMessageRow(player, message, msgId)
    if msgId and knownIds[msgId] then return end
    if msgId then knownIds[msgId] = true end

    if EmptyLbl.Parent then
        EmptyLbl:Destroy()
    end

    orderCounter += 1
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -4, 0, 0)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    row.BorderSizePixel = 0
    row.LayoutOrder = orderCounter
    row.Parent = MsgScroll
    do
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = row
        local pad = Instance.new("UIPadding")
        pad.PaddingTop = UDim.new(0, 6)
        pad.PaddingBottom = UDim.new(0, 6)
        pad.PaddingLeft = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 8)
        pad.Parent = row
    end

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size = UDim2.new(1, 0, 0, 16)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 12
    nameLbl.TextColor3 = ACCENT
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.Text = tostring(player or "?")
    nameLbl.Parent = row

    local textLbl = Instance.new("TextLabel")
    textLbl.Size = UDim2.new(1, 0, 0, 0)
    textLbl.AutomaticSize = Enum.AutomaticSize.Y
    textLbl.Position = UDim2.fromOffset(0, 16)
    textLbl.BackgroundTransparency = 1
    textLbl.Font = Enum.Font.Gotham
    textLbl.TextSize = 13
    textLbl.TextColor3 = TEXT
    textLbl.TextXAlignment = Enum.TextXAlignment.Left
    textLbl.TextYAlignment = Enum.TextYAlignment.Top
    textLbl.TextWrapped = true
    textLbl.Text = tostring(message or "")
    textLbl.Parent = row

    -- prune old rows
    local children = {}
    for _, ch in ipairs(MsgScroll:GetChildren()) do
        if ch:IsA("Frame") then
            children[#children + 1] = ch
        end
    end
    table.sort(children, function(a, b)
        return a.LayoutOrder < b.LayoutOrder
    end)
    while #children > MAX_VISIBLE do
        local old = table.remove(children, 1)
        if old then old:Destroy() end
    end

    task.defer(function()
        MsgScroll.CanvasPosition = Vector2.new(0, MsgScroll.AbsoluteCanvasSize.Y)
    end)
end

local function setStatus(online)
    if online then
        StatusDot.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
        StatusLbl.Text = "online"
        StatusLbl.TextColor3 = Color3.fromRGB(120, 220, 150)
    else
        StatusDot.BackgroundColor3 = Color3.fromRGB(220, 80, 80)
        StatusLbl.Text = "offline"
        StatusLbl.TextColor3 = Color3.fromRGB(220, 120, 120)
    end
end

-- ── API ────────────────────────────────────────────────────────────────────
local function fetchMessages()
    local ok, res = pcall(function()
        return httpRequest({
            Url = API_BASE .. "/api/messages?after_id=" .. tostring(lastId) .. "&limit=50",
            Method = "GET",
        })
    end)
    if not ok or not res then
        setStatus(false)
        return
    end
    local code = res.StatusCode or res.Status or 0
    if code < 200 or code >= 300 then
        setStatus(false)
        return
    end
    setStatus(true)
    local data = jsonDecode(res.Body)
    if not data or not data.ok or type(data.messages) ~= "table" then
        return
    end
    for _, m in ipairs(data.messages) do
        local id = tonumber(m.id) or 0
        if id > lastId then
            lastId = id
        end
        addMessageRow(m.player, m.message, id)
    end
end

local function cooldownLeft()
    local left = COOLDOWN_SEC - (tick() - lastSendAt)
    return math.max(0, left)
end

local function updateCooldownUI()
    local left = cooldownLeft()
    if left <= 0 then
        CdFill.Size = UDim2.new(1, 0, 1, 0)
        CdLbl.Text = "Ready"
        CdLbl.TextColor3 = Color3.fromRGB(120, 220, 150)
        SendBtn.BackgroundColor3 = ACCENT
        SendBtn.Text = "Send"
    else
        local p = 1 - (left / COOLDOWN_SEC)
        CdFill.Size = UDim2.new(math.clamp(p, 0, 1), 0, 1, 0)
        CdLbl.Text = string.format("Cooldown: %.1fs", left)
        CdLbl.TextColor3 = Color3.fromRGB(255, 180, 100)
        SendBtn.BackgroundColor3 = Color3.fromRGB(80, 70, 100)
        SendBtn.Text = string.format("%.0fs", left)
    end
end

local function sendMessage()
    if sending then return end
    local text = (InputBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end

    local left = cooldownLeft()
    if left > 0 then
        CdLbl.Text = string.format("Wait %.1fs", left)
        CdLbl.TextColor3 = Color3.fromRGB(255, 120, 120)
        return
    end

    local playerName = LP.DisplayName or LP.Name
    sending = true
    SendBtn.Text = "..."
    InputBox.Text = ""

    local ok, res = pcall(function()
        return httpRequest({
            Url = API_BASE .. "/api/send",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
            },
            Body = jsonEncode({
                player = playerName,
                message = text,
            }),
        })
    end)

    sending = false

    if not ok or not res then
        setStatus(false)
        CdLbl.Text = "Send failed"
        CdLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
        updateCooldownUI()
        return
    end

    local data = jsonDecode(res.Body)
    local code = res.StatusCode or res.Status or 0

    if data and data.ok then
        lastSendAt = tick()
        setStatus(true)
        if data.message then
            local m = data.message
            local id = tonumber(m.id) or 0
            if id > lastId then lastId = id end
            addMessageRow(m.player, m.message, id)
        end
    elseif data and data.error == "cooldown" then
        local retry = tonumber(data.retry_after) or COOLDOWN_SEC
        lastSendAt = tick() - (COOLDOWN_SEC - retry)
        CdLbl.Text = string.format("Cooldown: %.1fs", retry)
        CdLbl.TextColor3 = Color3.fromRGB(255, 180, 100)
    else
        local err = (data and data.error) or ("HTTP " .. tostring(code))
        CdLbl.Text = tostring(err)
        CdLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
        if code == 0 or code >= 500 then
            setStatus(false)
        end
    end
    updateCooldownUI()
end

SendBtn.MouseButton1Click:Connect(sendMessage)
InputBox.FocusLost:Connect(function(enter)
    if enter then sendMessage() end
end)

